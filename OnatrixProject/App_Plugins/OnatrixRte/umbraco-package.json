{
  "name": "Onatrix Rte",
  "alias": "Onatrix.Rte",
  "version": "1.0.0",
  "extensions": [
    {
      "type": "tiptapToolbarExtension",
      "kind": "styleMenu",
      "alias": "Onatrix.Tiptap.StyleMenu",
      "name": "Onatrix Tiptap Style Menu",
      "meta": { "alias": "OnatrixStyleMenu", "icon": "icon-palette", "label": "Onatrix Styles" },
      "items": [
        {
          "label": "Paragraphs (XL)",
          "items": [
            { "label": "Light",  "data": { "tag": "p", "class": "text-rte-xl font-light"   }, "appearance": { "style": "padding:5px;" } },
            { "label": "Normal", "data": { "tag": "p", "class": "text-rte-xl font-normal"  }, "appearance": { "style": "padding:5px;" } },
            { "label": "Bold",   "data": { "tag": "p", "class": "text-rte-xl font-bold"    }, "appearance": { "style": "padding:5px;" } }
          ]
        },
        {
          "label": "L – 40",
          "items": [
            { "label": "Light",  "data": { "tag": "p", "class": "text-rte-lg font-light"   }, "appearance": { "style": "padding:5px;" } },
            { "label": "Normal", "data": { "tag": "p", "class": "text-rte-lg font-normal"  }, "appearance": { "style": "padding:5px;" } },
            { "label": "Bold",   "data": { "tag": "p", "class": "text-rte-lg font-bold"    }, "appearance": { "style": "padding:5px;" } }
          ]
        },
        {
          "label": "M – 20",
          "items": [
            { "label": "Light",  "data": { "tag": "p", "class": "text-rte-md font-light"   }, "appearance": { "style": "padding:5px;" } },
            { "label": "Normal", "data": { "tag": "p", "class": "text-rte-md font-normal"  }, "appearance": { "style": "padding:5px;" } },
            { "label": "Bold",   "data": { "tag": "p", "class": "text-rte-md font-bold"    }, "appearance": { "style": "padding:5px;" } }
          ]
        },
        {
          "label": "S – 16",
          "items": [
            { "label": "Light",  "data": { "tag": "p", "class": "text-rte-sm font-light"   }, "appearance": { "style": "padding:5px;" } },
            { "label": "Normal", "data": { "tag": "p", "class": "text-rte-sm font-normal"  }, "appearance": { "style": "padding:5px;" } },
            { "label": "Bold",   "data": { "tag": "p", "class": "text-rte-sm font-bold"    }, "appearance": { "style": "padding:5px;" } }
          ]
        },
        {
          "label": "XS – 14",
          "items": [
            { "label": "Light",  "data": { "tag": "p", "class": "text-rte-xs font-light"   }, "appearance": { "style": "padding:5px;" } },
            { "label": "Normal", "data": { "tag": "p", "class": "text-rte-xs font-normal"  }, "appearance": { "style": "padding:5px;" } },
            { "label": "Bold",   "data": { "tag": "p", "class": "text-rte-xs font-bold"    }, "appearance": { "style": "padding:5px;" } }
          ]
        },
        {
          "label": "Bullets",
          "data": { "tag": "ul", "class": "rte-ul" }
        }
      ]
    },
    {
      "type": "tiptapToolbarExtension",
      "kind": "styleMenu",
      "alias": "Onatrix.Tiptap.BrandColors",
      "name": "Onatrix Brand Colors",
      "meta": { "alias": "onatrixBrandColors", "label": "Onatrix Colors" },
      "items": [
        {
          "label": "Primary",
          "data": { "tag": "span", "class": "text-primary" },
          "appearance": { "style": "background-color:#4F5955; color:#fff; padding:5px;" }
        },
        {
          "label": "Secondary",
          "data": { "tag": "span", "class": "text-secondary" },
          "appearance": { "style": "background-color:#D9C3A9; color:#000; padding:5px;" }
        },
        {
          "label": "Body",
          "data": { "tag": "span", "class": "text-body-text" },
          "appearance": { "style": "background-color:#535656; color:#fff; padding:5px;" }
        },
        {
          "label": "Body-Light",
          "data": { "tag": "span", "class": "text-body-100" },
          "appearance": { "style": "background-color:#999999; color:#fff; padding:5px;" }
        }
      ]
    }
  ]
}