{
  "name": "onatrixproject",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./wwwroot/css/input.css -o ./wwwroot/css/output.css",
    "watch": "tailwindcss -i ./wwwroot/css/input.css -o ./wwwroot/css/output.css --watch",
    "umbraco": "dotnet run",
    "start": "concurrently \"npm run watch\" \"npm run umbraco\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14"
  }
}