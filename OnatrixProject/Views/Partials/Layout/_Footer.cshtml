@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var rootContent = Umbraco.ContentAtRoot();
    var siteSettings = rootContent.OfType<SiteSettings>().FirstOrDefault();
}

<section class="bg-black w-full py-4 mt-auto">
    <div class="flex row justify-center md:justify-start items-center gap-2 text-sm text-center md:text-left px-6 lg:px-82">
        <p class="text-primary">@siteSettings?.CopyrightText</p>
        <p class="text-secondary">@siteSettings?.CreditName</p>
    </div>
</section>