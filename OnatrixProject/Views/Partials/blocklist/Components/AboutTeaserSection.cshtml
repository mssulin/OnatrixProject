@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.AboutTeaserSection)Model.Content;
}

<section class="custom-container pt-0 mt-0">
    <div class="max-w-[680px] mx-auto lg:mx-0 text-center lg:text-left">

        <!--- Heading --->
        <div class="flex flex-col gap-2 md:gap-2">
            <p class="label-secondary text-sm md:text-sm">@content.AboutTeaserLabel</p>
            <div class="label-primary text-[1.5rem] md:text-3xl">
                @content.AboutTeaserTitle
            </div>

            <!--- Body Text--->
            <div class="flex flex-col gap-3 md:gap-4">
                <div class="text-lg md:text-xl font-light leading-tight">@content.AboutTeaserCitation</div>
                <div class="text-sm md:text-base font-light leading-relaxed">
                    @content.AboutTeaserBody
                </div>

                <!--- Signature --->
                <div class="flex flex-col gap-2 pt-2 md:pt-3 items-center lg:items-start">
                    <img src="@content.SignatureImage?.Url()"
                         class="img-auto max-w-[161px w-full h-auto]"
                         alt="@content.SignatureName" />
                    <p class="text-sm md:text-base">@content.SignatureName</p>
                </div>
            </div>
        </div>
    </div>
</section>