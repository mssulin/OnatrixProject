@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.AboutTeaserSection)Model.Content;
}

<section class="custom-container py-10 md:py-16 lg:py-20">
    <div class="max-w-[680px] mx-auto lg:mx-0 text-center md:text-left lg:text-left">

        <!--- Heading --->
        <div class="flex flex-col gap-2 md:gap-2">
            <p class="uppercase text-secondary font-bold text-sm md:text-sm">@content.AboutTeaserLabel</p>
            <div class="text-[1.75rem] md:text-3xl lg:text-4xl font-bold">
                @content.AboutTeaserTitle
            </div>

            <!--- Body Text--->
            <div class="flex flex-col gap-3 md:gap-4 mt-4 md:mt-4">
                <div class="text-lg md:text-xl font-light leading-tight text-body-text">@content.AboutTeaserCitation</div>
                <div class="text-sm md:text-base font-light leading-relaxed text-body-text">
                    @content.AboutTeaserBody
                </div>

                <!--- Signature --->
                <div class="flex flex-col gap-2 pt-2 md:pt-3 items-center md:items-start">
                    <img src="@content.SignatureImage?.Url()" class="w-[120px] md:w-[161px] h-auto"/>
                    <p class="text-sm md:text-base">@content.SignatureName</p>
                </div>
            </div>
        </div>
    </div>
</section>