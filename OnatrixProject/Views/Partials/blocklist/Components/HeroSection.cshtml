@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using Umbraco.Cms.Core.Models
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.HeroSection)Model.Content;
}

<section class="relative min-h-[480px] md:min-h[640px] flex items-center">

        <!--- Background --->
    <div class="absolute inset-0">
        @if (content.HeroBgImg!= null)
        {
            <img src="@content.HeroBgImg.Url()" alt="" class="w-full h-full object-cover" />
        }
        <div class="absolute inset-0 bg-white/10"></div>
    </div>

    <!--- Content --->
    <div class="relative z-10 w-full px-6 md:px-10 lg:pl-32 xl:pl-80">
        <div class="max-w-[600px] flex flex-col gap-3 md:gap-4">
            
            <!--- Heading --->
            <h1 class="text-[2rem] md:text-[3rem] lg:text-[4.5rem] font-bold leading-tight text-primary mb-2">
                @Html.Raw(content.HeroTitle)
            </h1>
            <!--- Text --->
            <div class="text-primary/90 text-base md:text-lg leading-relaxed">
                @Html.Raw(content.HeroText)
            </div>

            <!--- Link --->
            @if (content.HeroLink != null)
            {
                <a href="@content.HeroLink.Url"
                   class="button-primary">
                    @content.HeroLink.Name
                </a>
            }
        </div>
    </div>
</section>