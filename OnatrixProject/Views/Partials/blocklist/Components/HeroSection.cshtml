@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using Umbraco.Cms.Core.Models
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.HeroSection)Model.Content;
    var hero = content?.HeroBgImg?.Url();
}

<section class="relative h-[380px] md:h-[320px] lg:h-[600px] flex items-start md:items-start">
    <!-- Background -->
    <div class="absolute inset-0">
        @if (!string.IsNullOrWhiteSpace(hero))
        {
            <img src="@hero" alt="@content?.HeroBgImg.Name" class="w-full h-full object-cover object-top"/>
        }
        <div class="absolute inset-0 bg-white/10"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 w-full px-6 md:pl-24 lg:pl-84 pt-10 md:pt-2 lg:pt-28">
        <div class="max-w-[600px] flex flex-col gap-3 md:gap-4">

            <!-- Heading -->
            <h1 class="text-[2rem] md:text-[2.5rem] lg:text-[3.5rem] label-primary leading-tight">
                @Html.Raw(content.HeroTitle)
            </h1>

            <!-- Text -->
            <div class="text-primary/90 text-base md:text-lg leading-relaxed text-center md:text-left">
                @Html.Raw(content.HeroText)
            </div>

            <!-- Button -->
            @if (content.HeroLink != null)
            {
                <div class="flex justify-center md:justify-start">
                    <a href="@content.HeroLink.Url"
                       class="button-primary -mt-1 md:-mt-2 lg:mt-0">
                        @content.HeroLink.Name
                    </a>
                </div>
            }
        </div>
    </div>
</section>