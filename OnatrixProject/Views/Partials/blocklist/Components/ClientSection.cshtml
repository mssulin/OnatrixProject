@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using Umbraco.Cms.Core.Models
@using ConfigurationExtensions = Microsoft.Extensions.Configuration.ConfigurationExtensions
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.ClientSection)Model.Content;
}

<section class="custom-container flex flex-col items-center justify-center md:py-20 text-center">
    <div class="flex flex-col items-center justify-center gap-4 text-center">

        <!--- Heading --->
        <div class="flex flex-col items-center justify-center gap-4 text-4xl">
            <h2 class="label-primary">@content.ClientTitle</h2>
            <p class="font-bold text-secondary">@content.TitleHighlighted</p>
        </div>

        <!--- Text --->
        <div class="text-body-text text-base md:text-lg leading-relaxed text-center max-w-[640px]">
            @Html.Raw(content.ClientBodyText)
        </div>

        <!--- Link --->
        @if (content.ClientLink != null)
        {
            <a href="@content.ClientLink.Url"
               class="button-primary">
                @content.ClientLink.Name
            </a>
        }

        <!--- Image --->
        <div class="custom-container mt-8 md:mt-10">
            @if (content.ClientImage != null)
            {
                <img src="@content.ClientImage.Url()" alt="" class="mx-auto block h-auto w-full max-w-[1100px] object-contain"/>
            }
        </div>
    </div>
</section>