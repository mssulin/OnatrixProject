@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using Umbraco.Cms.Core.Models
@using ConfigurationExtensions = Microsoft.Extensions.Configuration.ConfigurationExtensions
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.SuccessStorySection)Model.Content;
    var stats = content.SuccessStats;
}

<section class="relative overflow-visible min-h-[550px] md:min-h-[640px] lg:h-[812px] md:-mt-[80px] lg:-mt-[80px]
                flex flex-col items-center
                pt-12 md:pt-16 lg:pt-[80px] gap-10 lg:gap-14">

    <!--- Color background --->
    <div class="absolute inset-0 bg-primary -z-10"></div>

    <!--- Image background--->
    <div class="absolute inset-0 -z-10 bg-no-repeat bg-center
     [background-image:url('/images/backgrounds/dot-map.png')]
      md:bg-[position:center_60px]
      lg:bg-[position: center_120px]"></div>

    <!--- Heading --->
    <div class="z-10 relative text-white flex flex-col items-center justify-center gap-3 md:gap-4 text-center">
        <p class="label-secondary text-xs md:text-sm">@content.SuccessLabel</p>
        <p class="text-white text-2xl md:text-3xl lg:text-4xl font-bold">@content.SuccessTitle</p>
    </div>

    <!--- Stats --->
    <div class="z-10 relative text-white w-full">
    <div class="mx-auto max-w-6xl grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 md:gap-10">
        @if (stats != null)
        {
            @foreach (var block in stats)
            {
                var stat = (ContentModels.SuccessStatItem)block.Content;

                <div class="flex flex-col items-center justify-center gap-2">
                    <p class="text-secondary font-bold text-3xl md:text-4xl lg:text-5xl">@stat.StatNumber</p>
                    <p class="text-white font-semibold text-base md:text-lg max-w-[380px] text-center">@stat.StatDescription</p>
                </div>
            }
        }
    </div>
    </div>

    <!--- Image --->
    <div class="absolute left-1/2 transform -translate-x-1/2 -bottom-[50px] md:-bottom-[90px] lg:-bottom-[100px] z-0">
        @if (content.SuccessImage != null)
        {
            <img src="@content.SuccessImage.Url()" alt="" class="w-[100vw] max-w-[900px] md:max-w-[1000px] h-auto object-contain"/>
        }
    </div>
</section>