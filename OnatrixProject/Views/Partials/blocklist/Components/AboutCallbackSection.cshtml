@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using OnatrixProject.ViewModels
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.AboutCallbackSection)Model.Content;
    var settings = Model.Settings as ContentModels.AboutCallbackSettings;

    var formVM = new CallbackFormViewModel
    {
        Options = settings?.CallbackRequestOptions ?? []
    };
}

<section class="py-12">
    <div class="custom-container flex gap-10">
        
        <div class="flex flex-col w-7/12">
            <div class="rte">
                @Html.Raw(content.AboutCallbackBody)
            </div>
            </div>
        
            <div class="flex flex-col w-5/12 shadow-md -mt-[11rem] z-[99]">
                    <div class="bg-primary w-[510px] h-[100px]">
                        <p class="text-secondary py-6 px-8 text-[1.875rem] font-bold">
                            @(content.AboutCallbackTitle)
                        </p>
                    </div>

                    <p class="text-sm italic py-6 px-8">
                        @(content.AboutCallbackDesc)
                    </p>
                    
                    <partial name="Forms/_CallbackForm" model="formVM"/>
                    
                    @if (TempData["FormSuccess"] != null)
                    {
                        <div class="bg-green-50 text-green-700 p-4 mx-[2rem] mb-4 rounded-md">
                            @TempData["FormSuccess"]
                        </div>
                    } 
                    else if (TempData["FormError"] != null)
                    {
                        <div class="bg-red-50 text-red-700 p-4 mx-[2rem] mb-4 rounded-md">
                            @TempData["FormError"]
                        </div>
                    }
                    
            </div>
    </div>
</section>