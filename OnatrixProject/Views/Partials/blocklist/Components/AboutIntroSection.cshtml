@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.AboutIntroSection)Model.Content;
}

<section class="py-16">
    <div class="custom-container">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-14 items-start text-center md:text-left">

            <!--- Aside (image + name) --->
            <aside class="flex flex-col gap-2 items-center md:col-span-4 lg:col-span-4 md:items-start text-center md:text-left">
                <img src="@content.AboutIntroImage?.Url()" 
                     alt="" 
                     class="w-full h-auto rounded-lg object-cover max-w-sm md:max-w-none"/>
                <p class="text-sm text-body-text whitespace-normal lg:whitespace-nowrap lg:overflow-visible lg:text-clip">@content.IntroName</p>
            </aside>

            <!--- Text --->
            <div class="md:col-span-8 lg:-col-span-9 flex flex-col gap-6 lg:pl-10 items-center md:items-start">
                <div class="rte">@Html.Raw(content.AboutIntroText)</div>
            </div>

        </div>
    </div>
</section>