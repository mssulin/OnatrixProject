@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>;
@using Umbraco.Cms.Core.Models
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    var content = (ContentModels.ServiceItem)Model.Content;
}

<div class="flex flex-col">
    <h4 class="text-xl font-semibold">@content.ServiceTitle</h4>
    <div class="py-5 px-6">
        @if (content.ServiceImage != null)
        {
            <img src="@content.ServiceImage.Url()" alt="@content.ServiceTitle"/>
        }
        <p class="text-[var(--color-notel)]">@content.ServiceDescription</p>
    </div>
</div>