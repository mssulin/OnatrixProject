@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ServiceDetail>
@{
	Layout = "mainLayout.cshtml";
}

<partial name="Partials/Layout/_PageHeader" model="(IPageHeader)Model"/>

<section class="py-2 md:py-16">
	<div class="custom-container">
		<div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 lg:gap-10">

			<!-- Aside -->
			<aside class="w-full lg:w-3/12 flex flex-col gap-4 text-center md:text-left">
				@Html.GetBlockListHtml(Model.ServiceDetailsAsides)
			</aside>

			<!-- Divider -->
			<div class="hidden lg:block w-px bg-border-gray self-stretch"></div>

			<!-- Body -->
			<div class="w-full lg:w-8/12 flex flex-col gap-2 text-left">
				<div class="rte">@Html.Raw(Model.ServiceDetailBody)</div>
			</div>

		</div>
	</div>
</section>

@Html.GetBlockListHtml(Model.ServiceDetailSection)
